#############################################################################
# Wyzrdy / Easy Breezy / ForgeSEO — Environment Variable Reference
#
# Copy this file to `.env` in the same directory (apps/api/.env) and fill in
# real values. NEVER commit the populated `.env` file. Variables marked
# [REQUIRED] must be set for the related feature to function; variables
# marked [OPTIONAL] have sane defaults or only apply to opt-in features.
#
# Node loads this file automatically via `node --env-file=.env` — do not add
# dotenv or change the start script.
#############################################################################


#############################################################################
# NODE ENVIRONMENT
#############################################################################

# [OPTIONAL] Runtime environment: development | staging | production
# Default: development
NODE_ENV=development

# [REQUIRED] Port the Express API server listens on
PORT=3001

# [OPTIONAL] Public base URL of this API (used for building absolute links,
# OAuth redirect URIs, webhook callback URLs, etc.)
API_BASE_URL=http://localhost:3001

# [OPTIONAL] Public base URL of the frontend (used for OAuth redirects,
# CORS allow-list, email links, etc.)
APP_BASE_URL=http://localhost:3000


#############################################################################
# CORS & SECURITY
#############################################################################

# [REQUIRED] Comma-separated list of allowed origins for CORS. Leave empty to
# deny all cross-origin requests (safe default).
CORS_ORIGIN=

# [OPTIONAL] Trust the X-Forwarded-* headers (usually true behind a proxy/CDN)
TRUST_PROXY=true

# [OPTIONAL] Global rate limit — max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# [OPTIONAL] Per-integration/API-route rate limit overrides (requests/window)
RATE_LIMIT_AI_MAX_REQUESTS=30
RATE_LIMIT_SCRAPER_MAX_REQUESTS=20

# [OPTIONAL] Enable verbose security headers report-only mode (helmet CSP)
SECURITY_CSP_REPORT_ONLY=false


#############################################################################
# AUTHENTICATION (JWT / SESSION MANAGEMENT)
#
# Note: PocketBase issues and verifies its own auth JWTs for end-user login
# (see the PocketBase section below). These variables are for any ADDITIONAL
# server-side session/JWT handling done inside apps/api (e.g. signing
# short-lived service tokens, verifying webhook signatures).
#############################################################################

# [REQUIRED if using custom JWT signing in Express] Secret used to sign/verify
# custom JWTs issued by the Express layer. Use a long, random string.
JWT_SECRET=

# [OPTIONAL] JWT access token expiry (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# [OPTIONAL] JWT refresh token expiry
JWT_REFRESH_EXPIRES_IN=30d

# [OPTIONAL] Session cookie name / secret if server-side sessions are used
SESSION_COOKIE_NAME=wyzrdy_session
SESSION_SECRET=

# [OPTIONAL] Cookie security flags
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax


#############################################################################
# DATABASE CONNECTION — POCKETBASE
#############################################################################

# [REQUIRED] Base URL of the PocketBase instance
POCKETBASE_URL=http://127.0.0.1:8090

# [REQUIRED for server-side PB writes] Superuser (admin) credentials used by
# the Express-side lazy PocketBase client (apps/api/src/utils/pocketbaseClient.js)
# for operations that must bypass collection access rules.
# NEVER expose these to the frontend.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# [OPTIONAL] Timeout (ms) for PocketBase requests made from the server
POCKETBASE_REQUEST_TIMEOUT_MS=10000


#############################################################################
# Z.AI API
# https://z.ai — LLM / agent completion API
#############################################################################

# [REQUIRED to use Z.ai] API key
ZAI_API_KEY=your_z_ai_key_here

# [OPTIONAL] Base endpoint URL
ZAI_API_BASE_URL=https://api.z.ai/v1

# [OPTIONAL] Default model identifier
ZAI_DEFAULT_MODEL=GLM-4.7-Flash

# [OPTIONAL] Request timeout in ms
ZAI_TIMEOUT_MS=30000


#############################################################################
# ZAPIER MCP (Zap MCP)
# Model Context Protocol server for Zapier actions/triggers
#############################################################################

# [REQUIRED to use Zap MCP] MCP server URL / SSE endpoint
ZAP_MCP_SERVER_URL=

# [REQUIRED to use Zap MCP] API key / access token for the MCP connection
ZAP_MCP_API_KEY=

# [OPTIONAL] Workspace / account identifier
ZAP_MCP_WORKSPACE_ID=

# [OPTIONAL] Connection timeout in ms
ZAP_MCP_TIMEOUT_MS=15000


#############################################################################
# CLAUDE MCP
# Anthropic Claude via Model Context Protocol
#############################################################################

# [REQUIRED to use Claude MCP] Anthropic API key
CLAUDE_API_KEY=

# [OPTIONAL] MCP server URL if routed through a dedicated MCP gateway
CLAUDE_MCP_SERVER_URL=
GLM-4.7-Flash
# [OPTIONAL] Default Claude model
CLAUDE_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# [OPTIONAL] API version header
CLAUDE_API_VERSION=2023-06-01

# [OPTIONAL] Max tokens per completion
CLAUDE_MAX_TOKENS=4096


#############################################################################
# COMPOSIO API/SDK
# Tool/action integration platform for agents
#############################################################################

# [REQUIRED to use Composio] API key
COMPOSIO_API_KEY=your_composio_key_here

# [OPTIONAL] Base API URL
COMPOSIO_API_BASE_URL=https://backend.composio.dev/api

# [OPTIONAL] Default entity/user id used when invoking Composio actions
COMPOSIO_ENTITY_ID=all

# [OPTIONAL] Comma-separated list of enabled toolkits (e.g. github,slack,gmail)
COMPOSIO_ENABLED_TOOLKITS=all


#############################################################################
# OPENROUTER API
# Unified routing layer across multiple LLM providers
#############################################################################

# [REQUIRED to use OpenRouter] API key
OPENROUTER_API_KEY=your_openrouter_key_here

# [OPTIONAL] Base API URL
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# [OPTIONAL] Default model to route to
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash
# [OPTIONAL] Attribution headers required by OpenRouter
OPENROUTER_APP_NAME=Wyzrdy
OPENROUTER_APP_URL=http://localhost:3000


#############################################################################
# GEMINI VLM
# Google Gemini vision-language model API
#############################################################################

# [REQUIRED to use Gemini VLM] API key
GEMINI_API_KEY=

# [OPTIONAL] Base API URL
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# [OPTIONAL] Default vision-capable model
GEMINI_VLM_MODEL=gemini-1.5-pro

# [OPTIONAL] Max output tokens
GEMINI_MAX_OUTPUT_TOKENS=2048


#############################################################################
# PLAYWRIGHT
# Headless browser automation for scraping / testing
#############################################################################

# [OPTIONAL] Browser engine to launch: chromium | firefox | webkit
PLAYWRIGHT_BROWSER=chromium

# [OPTIONAL] Run browser headless (true) or headed (false)
PLAYWRIGHT_HEADLESS=true

# [OPTIONAL] Navigation timeout in ms
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000

# [OPTIONAL] Remote browser endpoint (if using a hosted Playwright/browser
# farm instead of a locally launched browser)
PLAYWRIGHT_REMOTE_ENDPOINT=

# [OPTIONAL] Proxy server for outbound browser traffic
PLAYWRIGHT_PROXY_SERVER=


#############################################################################
# FIRECRAWL
# Managed web scraping / crawling API
#############################################################################

# [REQUIRED to use Firecrawl] API key
FIRECRAWL_API_KEY=

# [OPTIONAL] Base API URL
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v1

# [OPTIONAL] Default crawl depth / page limit
FIRECRAWL_MAX_DEPTH=2
FIRECRAWL_MAX_PAGES=50

# [OPTIONAL] Request timeout in ms
FIRECRAWL_TIMEOUT_MS=60000


#############################################################################
# SPIDERCRAWLY
# Web crawling / indexing service
#############################################################################

# [REQUIRED to use SpiderCrawly] API key
SPIDERCRAWLY_API_KEY=

# [OPTIONAL] Base API URL
SPIDERCRAWLY_API_BASE_URL=https://api.spidercrawly.com/v1

# [OPTIONAL] Default concurrency / crawl rate
SPIDERCRAWLY_CONCURRENCY=5
SPIDERCRAWLY_REQUEST_DELAY_MS=500


#############################################################################
# PYDANTIC MCP
# Structured/validated data extraction via Pydantic-based MCP server
#############################################################################

# [REQUIRED to use Pydantic MCP] MCP server URL
PYDANTIC_MCP_SERVER_URL=

# [REQUIRED to use Pydantic MCP] Access token / API key
PYDANTIC_MCP_API_KEY=

# [OPTIONAL] Default schema/model registry namespace
PYDANTIC_MCP_NAMESPACE=default

# [OPTIONAL] Request timeout in ms
PYDANTIC_MCP_TIMEOUT_MS=20000


#############################################################################
# BEAUTIFUL SOUP 4
# HTML/XML parsing (typically invoked via a Python microservice or sidecar,
# since this Express service is Node/ESM). These variables configure the
# connection to that sidecar, if used.
#############################################################################

# [OPTIONAL] Base URL of the Beautiful Soup parsing sidecar/service
BS4_SERVICE_URL=

# [OPTIONAL] API key/token for the sidecar, if it requires auth
BS4_SERVICE_API_KEY=

# [OPTIONAL] Default parser: html.parser | lxml | html5lib
BS4_DEFAULT_PARSER=html.parser


#############################################################################
# OBSIDIAN API (Obsidian Local REST API plugin)
#############################################################################

# [REQUIRED to use Obsidian API] Base URL of the Obsidian Local REST API
OBSIDIAN_API_BASE_URL=https://127.0.0.1:27124

# [REQUIRED to use Obsidian API] API token generated by the Local REST API plugin
OBSIDIAN_API_TOKEN=

# [OPTIONAL] Vault name / identifier to target
OBSIDIAN_VAULT_NAME=

# [OPTIONAL] Allow self-signed TLS certs (Local REST API uses one by default)
OBSIDIAN_ALLOW_SELF_SIGNED_CERT=true


#############################################################################
# GOOGLE DRIVE API (OAuth 2.0)
#############################################################################

# [REQUIRED to use Google Drive] OAuth client ID from Google Cloud Console
GOOGLE_DRIVE_CLIENT_ID=

# [REQUIRED to use Google Drive] OAuth client secret
GOOGLE_DRIVE_CLIENT_SECRET=

# [REQUIRED to use Google Drive] OAuth redirect URI registered in the
# Google Cloud Console (must match exactly)
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/auth/google-drive/callback

# [OPTIONAL] Space-separated OAuth scopes
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.readonly

# [OPTIONAL] Long-lived refresh token (once obtained via OAuth flow), used
# for server-to-server access without re-prompting the user
GOOGLE_DRIVE_REFRESH_TOKEN=

# [OPTIONAL] Root folder ID to scope uploads/reads to
GOOGLE_DRIVE_ROOT_FOLDER_ID=


#############################################################################
# FILE STORAGE CONFIGURATION
#############################################################################

# [OPTIONAL] Storage driver: pocketbase | local | s3
FILE_STORAGE_DRIVER=pocketbase

# [OPTIONAL] Local filesystem path when FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_PATH=./storage

# [OPTIONAL] Max upload size in bytes
FILE_STORAGE_MAX_UPLOAD_BYTES=20971520

# [OPTIONAL] Comma-separated list of allowed MIME types
FILE_STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf

# --- S3-compatible storage (only used when FILE_STORAGE_DRIVER=s3) ---
# [REQUIRED if driver=s3] Bucket name
S3_BUCKET_NAME=
# [REQUIRED if driver=s3] Region
S3_REGION=
# [REQUIRED if driver=s3] Access key ID
S3_ACCESS_KEY_ID=
# [REQUIRED if driver=s3] Secret access key
S3_SECRET_ACCESS_KEY=
# [OPTIONAL] Custom S3-compatible endpoint (e.g. for R2/MinIO)
S3_ENDPOINT=


#############################################################################
# EMAIL SERVICE CREDENTIALS
#
# Note: Transactional email (welcome, confirmation, password reset, OTP) is
# normally handled by PocketBase's built-in mailer + pb_hooks/*.pb.js, not
# by this Express service. These variables are only for a DEDICATED
# marketing/notification email provider used directly from apps/api, if one
# is explicitly required.
#############################################################################

# [OPTIONAL] Email provider: smtp | sendgrid | resend | postmark
EMAIL_PROVIDER=smtp

# [OPTIONAL] From address / display name used on outbound emails
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Wyzrdy

# --- SMTP (only used when EMAIL_PROVIDER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Provider API keys (only used when matching EMAIL_PROVIDER is selected) ---
SENDGRID_API_KEY=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=


#############################################################################
# ANALYTICS & LOGGING
#############################################################################

# [OPTIONAL] Minimum log level: debug | info | warn | error
LOG_LEVEL=info

# [OPTIONAL] Log output format: json | pretty
LOG_FORMAT=json

# [OPTIONAL] Analytics provider write key (e.g. PostHog, Segment, Plausible)
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=

# [OPTIONAL] Error tracking / monitoring DSN (e.g. Sentry)
ERROR_TRACKING_DSN=

# [OPTIONAL] Enable request/response body logging (verbose, dev-only)
LOG_REQUEST_BODY=false


#############################################################################
# RATE LIMITING & QUOTA SETTINGS (per third-party integration)
#############################################################################

# [OPTIONAL] Daily request quota per integration (0 = unlimited)
QUOTA_ZAI_DAILY_REQUESTS=0
QUOTA_CLAUDE_DAILY_REQUESTS=0
QUOTA_OPENROUTER_DAILY_REQUESTS=0
QUOTA_GEMINI_DAILY_REQUESTS=0
QUOTA_FIRECRAWL_DAILY_REQUESTS=0
QUOTA_SPIDERCRAWLY_DAILY_REQUESTS=0
QUOTA_COMPOSIO_DAILY_REQUESTS=0

# [OPTIONAL] Backoff/retry configuration for outbound integration calls
INTEGRATION_RETRY_MAX_ATTEMPTS=3
INTEGRATION_RETRY_BASE_DELAY_MS=500
